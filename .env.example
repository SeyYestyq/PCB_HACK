# Web
# Legal chat UI → answer-core (local default :8090).
NEXT_PUBLIC_LEGAL_API_URL=http://127.0.0.1:8090
# Optional same-origin rewrite target for Next (`/api/*` → answer-core).
API_UPSTREAM=http://127.0.0.1:8090
# Leave empty on Vercel (same-origin /api via Services rewrite).
NEXT_PUBLIC_API_URL=http://localhost:8090/api/v1
NEXT_PUBLIC_DEMO_TOKEN=demo-masha-token

# API
HTTP_ADDR=:8090
DEMO_TOKEN=demo-masha-token
DEMO_OFFLINE=1
USE_MEMORY_STORE=1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./data/uploads
LOG_LEVEL=info

# --- LLM (OpenAI-compatible) ---
# Hackathon platform injects LLM_* / OPENAI_* at submit time (DeepSeek V4.1 Flash proxy).
# Local/dev: use your own DeepSeek key from https://platform.deepseek.com — never commit real keys.
# Prefer deepseek-chat for general; deepseek-reasoner for harder reasoning.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_PROVIDER=openai

# Aliases expected by organizer sample / platform
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# Optional: OpenCode Zen free tier (works without paid key) — rotate if primary fails
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LLM_API_KEY=public
# LLM_PROVIDER=opencode-zen
# LLM_MODEL=big-pickle
# LLM_MODELS=big-pickle,mimo-v2.5-free,nemotron-3.5-lightning-free,ling-3.0-flash-fin-free
# Optional paid backup:
# LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=deepseek-chat
# LLM_FALLBACK_PROVIDER=openai

# Optional OpenRouter (local A/B only; submit still uses platform DeepSeek)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LOCAL_DEV_LLM=openrouter

# Organizer knowledge base (txt corpus). Prefer real docs over fixtures.
PSB_KB_PATH=data/organizer/kb
# Batch eval input dir for `python3 solution.py --batch`
DATA_DIR=data/organizer/tests

# Optional full stack
DATABASE_URL=postgres://copilot:copilot@localhost:5432/copilot?sslmode=disable
REDIS_URL=redis://localhost:6379/0
